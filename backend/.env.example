# Apollo.io API (Leave blank to use deterministic Mock Enrichment Engine for zero-friction demos)
APOLLO_API_KEY=

# Google Gemini API (Leave blank to use local heuristic scoring fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase PostgreSQL (Leave blank to use local SQLite database gtm_leads.db)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
